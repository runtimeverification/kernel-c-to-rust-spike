_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":707},{"Deduplicated":707}],"output":{"Deduplicated":707}},"src":{"TraitImpl":{"impl_ref":{"id":24,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}},"trait_ref":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":707}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":2},"reuses_default":true}},"is_global_initializer":null,"body":"Opaque"},{"def_id":352,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["iter",0]},{"Impl":{"Trait":26}},{"Ident":["enumerate",0]}],"span":{"data":{"file_id":25,"beg":{"line":153,"col":8},"end":{"line":153,"col":45}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator which gives the current iteration count as well as"},{"DocComment":" the next value."},{"DocComment":""},{"DocComment":" The iterator returned yields pairs `(i, val)`, where `i` is the"},{"DocComment":" current index of iteration and `val` is the value returned by the"},{"DocComment":" iterator."},{"DocComment":""},{"DocComment":" `enumerate()` keeps its count as a [`usize`]. If you want to count by a"},{"DocComment":" different sized integer, the [`zip`] function provides similar"},{"DocComment":" functionality."},{"DocComment":""},{"DocComment":" # Overflow Behavior"},{"DocComment":""},{"DocComment":" The method does no guarding against overflows, so enumerating more than"},{"DocComment":" [`usize::MAX`] elements either produces the wrong result or panics. If"},{"DocComment":" overflow checks are enabled, a panic is guaranteed."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" The returned iterator might panic if the to-be-returned index would"},{"DocComment":" overflow a [`usize`]."},{"DocComment":""},{"DocComment":" [`zip`]: Iterator::zip"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = ['a', 'b', 'c'];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().enumerate();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some((0, 'a')));"},{"DocComment":" assert_eq!(iter.next(), Some((1, 'b')));"},{"DocComment":" assert_eq!(iter.next(), Some((2, 'c')));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"enumerate_method"},"generics":{"regions":[{"index":0,"name":"'a","mutability":"Unknown"}],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":9740}],"output":{"HashConsedValue":[9948,{"Adt":{"id":{"Adt":11},"generics":{"regions":[],"types":[{"Deduplicated":9740}],"const_generics":[],"trait_refs":[]}}}]}},"src":{"TraitImpl":{"impl_ref":{"id":26,"generics":{"regions":[{"Var":{"Free":0}}],"types":[{"Deduplicated":9729}],"const_generics":[],"trait_refs":[]}},"trait_ref":{"id":10,"generics":{"regions":[],"types":[{"Deduplicated":9740},{"Deduplicated":9741}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":16},"reuses_default":true}},"is_global_initializer":null,"body":"Opaque"},{"def_id":353,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["iter",0]},{"Impl":{"Trait":26}},{"Ident":["take",0]}],"span":{"data":{"file_id":25,"beg":{"line":153,"col":8},"end":{"line":153,"col":45}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator that yields the first `n` elements, or fewer"},{"DocComment":" if the underlying iterator ends sooner."},{"DocComment":""},{"DocComment":" `take(n)` yields elements until `n` elements are yielded or the end of"},{"DocComment":" the iterator is reached (whichever happens first)."},{"DocComment":" The returned iterator is a prefix of length `n` if the original iterator"},{"DocComment":" contains at least `n` elements, otherwise it contains all of the"},{"DocComment":" (fewer than `n`) elements of the original iterator."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().take(2);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" `take()` is often used with an infinite iterator, to make it finite:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut iter = (0..).take(3);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(0));"},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If less than `n` elements are available,"},{"DocComment":" `take` will limit itself to the size of the underlying iterator:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let v = [1, 2];"},{"DocComment":" let mut iter = v.into_iter().take(5);"},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Use [`by_ref`] to take from the iterator without consuming it, and then"},{"DocComment":" continue using the original iterator:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut words = [\"hello\", \"world\", \"of\", \"Rust\"].into_iter();"},{"DocComment":""},{"DocComment":" // Take the first two words."},{"DocComment":" let hello_world: Vec<_> = words.by_ref().take(2).collect();"},{"DocComment":" assert_eq!(hello_world, vec![\"hello\", \"world\"]);"},{"DocComment":""},{"DocComment":" // Collect the rest of the words."},{"DocComment":" // We can only do this because we used `by_ref` earlier."},{"DocComment":" let of_rust: Vec<_> = words.collect();"},{"DocComment":" assert_eq!(of_rust, vec![\"of\", \"Rust\"]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`by_ref`]: Iterator::by_ref"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":"'a","mutability":"Unknown"}],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":9740},{"Deduplicated":707}],"output":{"HashConsedValue":[9949,{"Adt":{"id":{"Adt":12},"generics":{"regions":[],"types":[{"Deduplicated":9740}],"const_generics":[],"trait_refs":[]}}}]}},"src":{"TraitImpl":{"impl_ref":{"id":26,"generics":{"regions":[{"Var":{"Free":0}}],"types":[{"Deduplicated":9729}],"const_generics":[],"trait_refs":[]}},"trait_ref":{"id":10,"generics":{"regions":[],"types":[{"Deduplicated":9740},{"Deduplicated":9741}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":22},"reuses_default":true}},"is_global_initializer":null,"body":"Opaque"},{"def_id":354,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["adapters",0]},{"Ident":["take",0]},{"Impl":{"Trait":27}},{"Ident":["enumerate",0]}],"span":{"data":{"file_id":17,"beg":{"line":29,"col":0},"end":{"line":31,"col":16}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator which gives the current iteration count as well as"},{"DocComment":" the next value."},{"DocComment":""},{"DocComment":" The iterator returned yields pairs `(i, val)`, where `i` is the"},{"DocComment":" current index of iteration and `val` is the value returned by the"},{"DocComment":" iterator."},{"DocComment":""},{"DocComment":" `enumerate()` keeps its count as a [`usize`]. If you want to count by a"},{"DocComment":" different sized integer, the [`zip`] function provides similar"},{"DocComment":" functionality."},{"DocComment":""},{"DocComment":" # Overflow Behavior"},{"DocComment":""},{"DocComment":" The method does no guarding against overflows, so enumerating more than"},{"DocComment":" [`usize::MAX`] elements either produces the wrong result or panics. If"},{"DocComment":" overflow checks are enabled, a panic is guaranteed."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" The returned iterator might panic if the to-be-returned index would"},{"DocComment":" overflow a [`usize`]."},{"DocComment":""},{"DocComment":" [`zip`]: Iterator::zip"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = ['a', 'b', 'c'];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().enumerate();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some((0, 'a')));"},{"DocComment":" assert_eq!(iter.next(), Some((1, 'b')));"},{"DocComment":" assert_eq!(iter.next(), Some((2, 'c')));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"enumerate_method"},"generics":{"regions":[],"types":[{"index":0,"name":"I"},{"index":1,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":17,"beg":{"line":31,"col":7},"end":{"line":31,"col":15}},"generated_from_span":null},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"skip_binder":{"id":10,"generics":{"regions":[],"types":[{"Deduplicated":9729},{"Deduplicated":9730}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"input