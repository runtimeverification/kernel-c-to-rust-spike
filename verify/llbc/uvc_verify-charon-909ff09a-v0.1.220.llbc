is a no-op here, exactly as the stubbed C.)\n\n        self.interval_cursor += n as usize;\n\n        // Commit the frame. In C this write happened field-by-field directly\n        // into frames[format->nframes]; same destination, same values.\n        self.frames[frame_idx] = frame;\n\n        buf[pos] as i32\n    }","attr_info":{"attributes":[{"DocComment":" Port of `uvc_parse_frame` (uvc_driver.c:227-333)."},{"DocComment":""},{"DocComment":" `frame_idx` is the absolute index into `self.frames` that the C code"},{"DocComment":" reaches via `&frames[format->nframes]`. Returns bytes consumed"},{"DocComment":" (`buffer[0]`) or `-EINVAL`."}],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"},{"index":2,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[9895,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":1500},"Mut"]}]},{"Deduplicated":716},{"HashConsedValue":[9896,{"Ref":[{"Var":{"Free":1}},{"Deduplicated":1338},"Shared"]}]},{"Deduplicated":707},{"Deduplicated":708},{"Deduplicated":712},{"HashConsedValue":[9897,{"Ref":[{"Var":{"Free":2}},{"Deduplicated":934},"Shared"]}]},{"Deduplicated":707},{"Deduplicated":712}],"output":{"Deduplicated":712}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":0,"beg":{"line":392,"col":4},"end":{"line":503,"col":5}},"generated_from_span":null},"bound_body_regions":61,"locals":{"arg_count":9,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":0,"beg":{"line":402,"col":9},"end":{"line":402,"col":12}},"generated_from_span":null},"ty":{"Deduplicated":712}},{"index":1,"name":"self","span":{"data":{"file_id":0,"beg":{"line":393,"col":